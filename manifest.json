{
   "author": "Dmytro Prokopenko",
   "background": {
      "service_worker": "init.js"
   },
   "action": {
      "default_icon": {
         "19": "action.png",
         "38": "action.png"
      },
      "default_popup": "background.html",
      "default_title": "Faster Top Bookmark Button"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "chromeos": "Ctrl+B",
            "default": "Ctrl+B",
            "linux": "Alt+B",
            "mac": "Command+B",
            "windows": "Alt+B"
         }
      }
   },
   "description": "Easily add bookmarks to the top of any folder. Includes spotlight-like search with mouse/kb support. Default key: ⌘+b (win/linux: alt+b).",
   "homepage_url": "https://github.com/dmytro-pro/chrome-faster-top-bookmark",
   "icons": {
      "128": "bookmark.png",
      "16": "bookmark.png",
      "48": "bookmark.png"
   },
   "manifest_version": 3,
   "name": "Faster Top Bookmark - Add Bookmark faster",
   "permissions": [ "bookmarks", "tabs" ],
   "version": "1.0.1"
}
